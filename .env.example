# Root .env — used ONLY by docker compose for ${VAR} interpolation in compose.yml.
# Keep in sync with backend/.env (which the Python app reads).

# PostgreSQL
POSTGRES_USER=changeme
POSTGRES_PASSWORD=changeme
POSTGRES_DB=appdb

# Label Studio
LABEL_STUDIO_DB=labelstudio
LABEL_STUDIO_USERNAME=admin@example.com
LABEL_STUDIO_PASSWORD=changeme

# MinIO
MINIO_ROOT_USER=changeme
MINIO_ROOT_PASSWORD=changeme
